    {
      "id": "18f7893a-861c-4b5c-b1f4-3d9200aa0005",
      "name": "Restablecer filtro de precio a valores iniciales",
      "commands": [
        {
          "id": "cmd-51",
          "comment": "Abrir página principal",
          "command": "open",
          "target": "/#/",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-52",
          "comment": "Ajustar ventana",
          "command": "setWindowSize",
          "target": "1500x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-53",
          "comment": "Esperar slider maximo",
          "command": "waitForElementVisible",
          "target": "css=.ngx-slider-pointer-max",
          "targets": [
            ["css=.ngx-slider-pointer-max", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-54",
          "comment": "Paso 1: Reducir maximo a la izquierda",
          "command": "executeScript",
          "target": "const el = document.querySelector('.ngx-slider-pointer-max'); const rect = el.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; el.dispatchEvent(new MouseEvent('mousedown', { clientX: cx, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mousemove', { clientX: cx - 120, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mouseup', { clientX: cx - 120, clientY: cy, bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-55",
          "comment": "Pausa breve",
          "command": "pause",
          "target": "1000",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-56",
          "comment": "Paso 2: Restablecer arrastrando con precision al 50% de la barra (valor 100)",
          "command": "executeScript",
          "target": "const el = document.querySelector('.ngx-slider-pointer-max'); const rect = el.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; const slider = document.querySelector('.ngx-slider'); const sRect = slider.getBoundingClientRect(); const targetX = sRect.left + (sRect.width * 0.5); el.dispatchEvent(new MouseEvent('mousedown', { clientX: cx, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mousemove', { clientX: targetX, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mouseup', { clientX: targetX, clientY: cy, bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-57",
          "comment": "Pausa para estabilizar valor",
          "command": "pause",
          "target": "1500",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-58",
          "comment": "Validar que el precio maximo regreso a su valor inicial de 100",
          "command": "assertText",
          "target": "css=.ngx-slider-model-high",
          "targets": [
            ["css=.ngx-slider-model-high", "css:finder"]
          ],
          "value": "100"
        }
      ]
    },
    {
      "id": "18f7893a-861c-4b5c-b1f4-3d9200aa0006",
      "name": "Poner slider al precio maximo (200)",
      "commands": [
        {
          "id": "cmd-61",
          "comment": "Abrir página principal",
          "command": "open",
          "target": "/#/",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-62",
          "comment": "Ajustar ventana",
          "command": "setWindowSize",
          "target": "1500x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-63",
          "comment": "Esperar slider maximo",
          "command": "waitForElementVisible",
          "target": "css=.ngx-slider-pointer-max",
          "targets": [
            ["css=.ngx-slider-pointer-max", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-64",
          "comment": "Arrastrar slider hacia la derecha total hasta el tope maximo (200)",
          "command": "executeScript",
          "target": "const el = document.querySelector('.ngx-slider-pointer-max'); const rect = el.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; const slider = document.querySelector('.ngx-slider'); const sRect = slider.getBoundingClientRect(); const targetX = sRect.right + 20; el.dispatchEvent(new MouseEvent('mousedown', { clientX: cx, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mousemove', { clientX: targetX, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mouseup', { clientX: targetX, clientY: cy, bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-65",
          "comment": "Pausa para registrar el nuevo valor maximo",
          "command": "pause",
          "target": "1500",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-66",
          "comment": "Validar que el precio maximo alcanza el techo de 200",
          "command": "assertText",
          "target": "css=.ngx-slider-model-high",
          "targets": [
            ["css=.ngx-slider-model-high", "css:finder"]
          ],
          "value": "200"
        }
      ]
    }
