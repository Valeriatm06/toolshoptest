            ["css=img[alt='Combination Pliers']", "css:finder"]
          ],
          "value": ""
        },
        {
          "id": "cmd-28",
          "comment": "Esperar al precio unitario del producto en detalle",
          "command": "waitForElementVisible",
          "target": "css=[data-test=\"unit-price\"]",
          "targets": [
            ["css=[data-test=\"unit-price\"]", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-29",
          "comment": "Validar que el precio coincide con el catalogo filtrado ($14.15)",
          "command": "assertText",
          "target": "css=[data-test=\"unit-price\"]",
          "targets": [
            ["css=[data-test=\"unit-price\"]", "css:finder"]
          ],
          "value": "14.15"
        }
      ]
    },
    {
      "id": "18f7893a-861c-4b5c-b1f4-3d9200aa0004",
      "name": "Filtrar por precio y ordenar de Menor a Mayor",
      "commands": [
        {
          "id": "cmd-31",
          "comment": "Abrir página principal",
          "command": "open",
          "target": "/#/",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-32",
          "comment": "Ajustar ventana",
          "command": "setWindowSize",
          "target": "1500x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-33",
          "comment": "Esperar slider maximo",
          "command": "waitForElementVisible",
          "target": "css=.ngx-slider-pointer-max",
          "targets": [
            ["css=.ngx-slider-pointer-max", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-34",
          "comment": "Reducir precio maximo",
          "command": "executeScript",
          "target": "const el = document.querySelector('.ngx-slider-pointer-max'); const rect = el.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; el.dispatchEvent(new MouseEvent('mousedown', { clientX: cx, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mousemove', { clientX: cx - 80, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mouseup', { clientX: cx - 80, clientY: cy, bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-35",
          "comment": "Pausa para reflejar cambio en el catalogo",
          "command": "pause",
          "target": "1500",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-36",
          "comment": "Esperar selector de ordenamiento",
          "command": "waitForElementVisible",
          "target": "css=[data-test=\"sort\"]",
          "targets": [
