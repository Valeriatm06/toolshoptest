{
  "id": "2b6b5536-e0e9-4e08-9df2-36423c4a2db6",
  "version": "2.0",
  "name": "Practice Software Testing - Filtro Precios",
  "url": "https://practicesoftwaretesting.com",
  "tests": [
    {
      "id": "18f7893a-861c-4b5c-b1f4-3d9200aa0001",
      "name": "Reducir precio maximo en slider",
      "commands": [
        {
          "id": "cmd-01",
          "comment": "Abrir página principal",
          "command": "open",
          "target": "/#/",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-02",
          "comment": "Ajustar tamaño de ventana",
          "command": "setWindowSize",
          "target": "1500x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-03",
          "comment": "Esperar a que el deslizador máximo esté presente",
          "command": "waitForElementVisible",
          "target": "css=.ngx-slider-pointer-max",
          "targets": [
            ["css=.ngx-slider-pointer-max", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-04",
          "comment": "Arrastrar slider hacia la izquierda para reducir precio maximo",
          "command": "executeScript",
          "target": "const el = document.querySelector('.ngx-slider-pointer-max'); const rect = el.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; el.dispatchEvent(new MouseEvent('mousedown', { clientX: cx, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mousemove', { clientX: cx - 120, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mouseup', { clientX: cx - 120, clientY: cy, bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-05",
          "comment": "Pausa para actualizar productos en catalogo",
          "command": "pause",
          "target": "1500",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-06",
          "comment": "Obtener valor actual del precio maximo",
          "command": "storeText",
          "target": "css=.ngx-slider-model-high",
          "targets": [
            ["css=.ngx-slider-model-high", "css:finder"]
          ],
          "value": "maxPrice"
        },
        {
          "id": "cmd-07",
          "comment": "Verificar que el precio se redujo respecto al inicial (100)",
          "command": "executeScript",
          "target": "return Number(arguments[0]) < 100;",
          "targets": [],
          "value": "esMenor"
        },
        {
          "id": "cmd-08",
          "comment": "Confirmar reduccion exitosa",
          "command": "assert",
          "target": "esMenor",
          "targets": [],
          "value": "true"
        }
      ]
    },
    {
      "id": "18f7893a-861c-4b5c-b1f4-3d9200aa0002",
      "name": "Aumentar precio minimo en slider",
      "commands": [
        {
          "id": "cmd-11",
          "comment": "Abrir página principal",
          "command": "open",
          "target": "/#/",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-12",
          "comment": "Ajustar tamaño de ventana",
          "command": "setWindowSize",
          "target": "1500x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-13",
          "comment": "Esperar al deslizador mínimo",
          "command": "waitForElementVisible",
          "target": "css=.ngx-slider-pointer-min",
          "targets": [
            ["css=.ngx-slider-pointer-min", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-14",
          "comment": "Arrastrar slider hacia la derecha para incrementar precio minimo",
          "command": "executeScript",
          "target": "const el = document.querySelector('.ngx-slider-pointer-min'); const rect = el.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; el.dispatchEvent(new MouseEvent('mousedown', { clientX: cx, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mousemove', { clientX: cx + 100, clientY: cy, bubbles: true })); document.dispatchEvent(new MouseEvent('mouseup', { clientX: cx + 100, clientY: cy, bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-15",
          "comment": "Pausa para actualizar catálogo",
          "command": "pause",
          "target": "1500",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-16",
          "comment": "Obtener valor actual del precio minimo",
          "command": "storeText",
          "target": "css=.ngx-slider-model-value",
          "targets": [
            ["css=.ngx-slider-model-value", "css:finder"]
          ],
          "value": "minPrice"
        },
        {
          "id": "cmd-17",
          "comment": "Verificar que el precio minimo subio por encima de 1",
          "command": "executeScript",
          "target": "return Number(arguments[0]) > 1;",
          "targets": [],
          "value": "esMayor"
        },
        {
          "id": "cmd-18",
          "comment": "Confirmar aumento de precio minimo",
          "command": "assert",
          "target": "esMayor",
          "targets": [],
          "value": "true"
        }
      ]
    },
    {
