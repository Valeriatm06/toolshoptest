          ],
          "value": "10000"
        },
        {
          "id": "cmd-37",
          "comment": "Seleccionar ordenamiento: Precio (Bajo - Alto)",
          "command": "select",
          "target": "css=[data-test=\"sort\"]",
          "targets": [
