          "command": "waitForElementVisible",
          "target": "css=img[alt='Combination Pliers']",
          "targets": [
            ["css=img[alt='Combination Pliers']", "css:finder"]
          ],
          "value": "10000"
        },
        {
          "id": "cmd-40",
          "comment": "Clic en producto",
